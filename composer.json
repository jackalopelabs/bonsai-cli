{
    "name": "jackalopelabs/bonsai-cli",
    "description": "A CLI tool for adding components to a Roots WP project",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "roots/acorn": "^5.0",
        "symfony/yaml": "^6.4",
        "illuminate/console": "^12.0",
        "blade-ui-kit/blade-heroicons": "^2.2",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Jackalopelabs\\BonsaiCli\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "jackalopelabs/bonsai-cli": true
        }
    },
    "extra": {
        "class": "Jackalopelabs\\BonsaiCli\\Composer\\BonsaiInstallerPlugin",
        "acorn": {
            "providers": [
                "Jackalopelabs\\BonsaiCli\\Providers\\BonsaiServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Mason Lawlor",
            "email": "mason@jackalope.io"
        }
    ]
}
