#!/usr/bin/env php
<?php

// Suppress deprecation warnings
error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);

require __DIR__.'/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use Jackalopelabs\BonsaiCli\Commands\ScionCommand;

$application = new Application('Bonsai CLI', '1.0.0');
$application->add(new ScionCommand());
$application->run();
